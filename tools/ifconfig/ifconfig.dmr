# DMOD Resource File for ifconfig
# This file specifies where resources should be installed
#
# ifconfig lives nested under dmnet/tools/ifconfig rather than being its own
# top-level repo, so ${repo_dir}/${build_dir} below (which always resolve
# to the dmnet repo/build root, not this subdirectory) are prefixed with
# tools/ifconfig - same convention lib/dmnetif/dmnetif.dmr uses.

# === Core Module ===
# Main module file - always installed
dmf=./${module}.dmf => ${destination}/${module}.dmf [origin=${dmf_dir}/${module}.dmf]

# Compressed module
dmfc=./${module}.dmfc => ${destination}/${module}.dmfc [origin=${build_dir}/dmfc/${module}.dmfc]

# Dependencies file (if exists)
dmd=./${module}.dmd => ${destination}/${module}.dmd [origin=${dmf_dir}/${module}.dmd]

# Version information
version=./${module}_version.txt => ${destination}/${module}_version.txt [origin=${dmf_dir}/${module}_version.txt]

# === Documentation ===
# Module documentation in markdown format for dmf-man tool
docs=./docs => ${destination}/${module}/docs [origin=${repo_dir}/tools/ifconfig/docs]

# README file
readme=./README.md => ${destination}/${module}/README.md [origin=${repo_dir}/tools/ifconfig/README.md]

# No include/ entry - this is a CLI application with no public header of
# its own (its API is dmnetif's, see lib/dmnetif).

# === License ===
# License file - shared at the dmnet repo root (see lib/dmnetif/dmnetif.dmr
# for the same "nested module shares the parent repo's LICENSE" convention)
license=./LICENSE => ${destination}/${module}/LICENSE [origin=${repo_dir}/LICENSE]

# Adding itself
dmr=./${module}.dmr => ${destination}/${module}/${module}.dmr [origin=${repo_dir}/tools/ifconfig/${module}.dmr]
